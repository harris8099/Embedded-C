#include "main.h"
#include <string.h>
#include <stdint.h>
#include <stdio.h>

void SystemClockConfig(uint8_t clock_freq);
void USART2_Init(void);
void Error_handler(void);

UART_HandleTypeDef huart2;

int main(void)
{
	HAL_Init();
	SystemClockConfig(SYS_CLOCK_FREQ_50MHZ);
	USART2_Init();

	char msg[100];

	memset(msg, 0, sizeof(msg));
	sprintf(msg, "SYSCLK : %ld\r\n", HAL_RCC_GetSysClockFreq());
	HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

	memset(msg, 0, sizeof(msg));
	sprintf(msg, "HCLK : %ld\r\n", HAL_RCC_GetHCLKFreq());
	HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

	memset(msg, 0, sizeof(msg));
	sprintf(msg, "PCLK1 : %ld\r\n", HAL_RCC_GetPCLK1Freq());
	HAL_UART_Transmit(&huart2,(uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

	memset(msg, 0, sizeof(msg));
	sprintf(msg, "PCLK2 : %ld\r\n", HAL_RCC_GetPCLK2Freq());
	HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);

	while(1);
	return 0;
}

void Error_handler(void)
{
	while(1);
}

void SystemClockConfig(uint8_t clock_freq)
{
	RCC_OscInitTypeDef osc_init;
	RCC_ClkInitTypeDef clk_init;
	RCC_PLLInitTypeDef pll_init;

	//It is required when we are changing the default clock config like default is PLL and we want HSE or other then
	HAL_SYSTICK_Config(HAL_RCC_GetHCLKFreq()/1000);
	HAL_SYSTICK_CLKSourceConfig(SYSTICK_CLKSOURCE_HCLK);


	memset(&osc_init, 0,sizeof(osc_init));
	memset(&clk_init, 0,sizeof(clk_init));
	memset(&pll_init, 0,sizeof(pll_init));

	osc_init.OscillatorType = RCC_OSCILLATORTYPE_HSI;
	osc_init.HSIState = RCC_HSI_ON;
	osc_init.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;

	pll_init.PLLState = RCC_PLL_ON;
	pll_init.PLLSource = RCC_PLLSOURCE_HSI;

	switch(clock_freq)
	{
		case SYS_CLOCK_FREQ_50MHZ:
		{
			pll_init.PLLM = 16;
			pll_init.PLLN = 100;
			pll_init.PLLP = RCC_PLLP_DIV2;
			pll_init.PLLQ = 2;

			clk_init.ClockType = RCC_CLOCKTYPE_SYSCLK | RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
			clk_init.SYSCLKSource = RCC_SYSCLKSOURCE_HSI;
			clk_init.AHBCLKDivider = RCC_SYSCLK_DIV1;
			clk_init.APB1CLKDivider = RCC_HCLK_DIV2;
			clk_init.APB2CLKDivider = RCC_HCLK_DIV2;

			break;
		}
		case SYS_CLOCK_FREQ_84MHZ:
		{
			pll_init.PLLM = 16;
			pll_init.PLLN = 168;
			pll_init.PLLP = RCC_PLLP_DIV2;
			pll_init.PLLQ = 2;
			break;
		}
		case SYS_CLOCK_FREQ_120MHZ:
		{
			pll_init.PLLM = 16;
			pll_init.PLLN = 240;
			pll_init.PLLP = RCC_PLLP_DIV2;
			pll_init.PLLQ = 2;
			break;
		}
		default:
			break;
	}
	osc_init.PLL = pll_init;


	if( HAL_RCC_OscConfig(&osc_init) != HAL_OK)
	{
		Error_handler();
	}



	if ( HAL_RCC_ClockConfig(&clk_init, FLASH_ACR_LATENCY_0WS) != HAL_OK)
	{
		Error_handler();
	}
}

void USART2_Init(void)
{
	huart2.Instance = USART2;
	huart2.Init.BaudRate = 115200;
	huart2.Init.WordLength = UART_WORDLENGTH_8B;
	huart2.Init.StopBits = UART_STOPBITS_1;
	huart2.Init.Parity = UART_PARITY_NONE;
	huart2.Init.Mode = UART_MODE_TX_RX;
	huart2.Init.HwFlowCtl = UART_HWCONTROL_NONE;
	huart2.Init.OverSampling = UART_OVERSAMPLING_16;

	if( HAL_UART_Init(&huart2) != HAL_OK )
	{
		// There is a problem
		Error_handler();
	}
}
